# Secrets for SnipeKlein. Copy to .env and fill in. Never commit .env.

# Discord webhook for deal alerts (spec 7)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE/ME

# Optional: Discord targets to mention on alerts. A raw user ID, `<@ID>`,
# role mention `<@&ID>`, or the explicit broad mentions `everyone` / `here`
# work; separate multiple targets with commas. Leave empty/unset to send the
# alert without a ping. DEAL_PING_TARGET covers actionable deals,
# OUTLIER_PING_TARGET covers extreme outliers (no fallback between them).
DEAL_PING_TARGET=
OUTLIER_PING_TARGET=

# Google AI Studio key for the Gemini extraction model.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Credentials for the read-only decision panel (compose service "panel").
# The panel refuses to start on a public interface without them.
PANEL_USER=snipeklein
PANEL_PASSWORD=change-me

# Optional: only needed for the openai-compatible provider.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1

# Optional: German/EU residential proxy so the crawler egresses from DACH.
# PROXY_URL=http://user:pass@host:port
